{
  "name": "setvault-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "site:build": "node ../scripts/build-site-assets.mjs",
    "site:serve": "npm run site:build && npx --yes serve ../site"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@tanstack/svelte-query": "^5.51.0",
    "svelte": "^4.2.0",
    "svelte-check": "^3.8.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0",
    "wavesurfer.js": "^7.7.0"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "svelte-i18n": "^4.0.0",
    "tus-js-client": "^4.3.1"
  }
}
