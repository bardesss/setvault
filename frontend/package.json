{
  "name": "setvault-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "site:build": "node ../scripts/build-site-assets.mjs",
    "site:serve": "npm run site:build && npx --yes serve ../site"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "intl-messageformat": "^12.1.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wavesurfer.js": "^8.0.5"
  },
  "dependencies": {
    "svelte-i18n": "^4.0.0",
    "tus-js-client": "^4.3.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
